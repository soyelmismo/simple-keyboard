<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="screen_appearance"
    android:title="@string/settings_screen_appearance">

    <PreferenceCategory
        android:title="@string/settings_category_theme_style">

        <Preference
            android:key="screen_theme"
            android:title="@string/settings_screen_theme"
            android:fragment="rkr.simplekeyboard.inputmethod.latin.settings.ThemeSettingsFragment"
            app:widgetLayout="@layout/preference_chevron" />

        <ListPreference
            android:key="pref_key_shape"
            android:title="@string/key_shape"
            android:entries="@array/key_shape_entries"
            android:entryValues="@array/key_shape_values"
            android:defaultValue="rounded"
            app:useSimpleSummaryProvider="true"
            app:widgetLayout="@layout/preference_chevron" />

        <SwitchPreferenceCompat
            android:key="pref_show_suggestion_bar"
            android:title="@string/show_suggestion_bar"
            android:summary="@string/show_suggestion_bar_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_dimensions">

        <rkr.simplekeyboard.inputmethod.latin.settings.SeekBarDialogPreference
            android:key="pref_keyboard_height"
            android:title="@string/prefs_keyboard_height_settings"
            app:minValue="@integer/config_min_keyboar_height"
            app:maxValue="@integer/config_max_keyboar_height"
            app:stepValue="@integer/config_keyboar_height_step" />

        <rkr.simplekeyboard.inputmethod.latin.settings.SeekBarDialogPreference
            android:key="pref_bottom_offset_portrait"
            android:title="@string/prefs_bottom_offset_portrait_settings"
            app:minValue="@integer/config_min_bottom_offset_portrait"
            app:maxValue="@integer/config_max_bottom_offset_portrait"
            app:stepValue="@integer/config_bottom_offset_step" />

    </PreferenceCategory>

</PreferenceScreen>
